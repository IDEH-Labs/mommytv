<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: favourites, the PIN and the saved playlist stay on this device; neither cloud backup
     nor a transfer to a new phone copies them (allowBackup only covers older versions). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
