<?xml version="1.0" encoding="UTF-8"?>
<!-- MommyTV for Samsung Tizen TVs (2017 and later: Tizen 3.0+, Chromium-based like webOS).
     Least privilege: the playlist and streams (internet), shortcuts to installed apps (application.launch)
     and the number, channel and colour keys (tv.inputdevice). -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://ideh.top/mommytv" version="0.1.3" viewmodes="maximized">
    <tizen:application id="MommyTVapp.MommyTV" package="MommyTVapp" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>MommyTV</name>
    <access origin="*" subdomains="true"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv"/>
</widget>
